{
  "name": "glyph-avatar-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/playground",
    "apps/site"
  ],
  "scripts": {
    "build": "npm run build -w glyph-avatar",
    "test": "npm run test -w glyph-avatar",
    "typecheck": "tsc -p packages/core && npm run typecheck -w playground && npm run typecheck -w site",
    "dev": "npm run dev -w playground",
    "site": "npm run dev -w site",
    "assets": "tsx scripts/readme-assets.ts",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it"
  },
  "devDependencies": {
    "release-it": "^21.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
