{
  "git": {
    "commitMessage": "${version}",
    "tagName": "${version}",
    "tagAnnotation": "${version}",
    "requireBranch": "main",
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "${version}",
    "releaseNotes": "node scripts/release/changelog.mjs notes ${version}"
  },
  "hooks": {
    "before:init": ["npm test", "npm run typecheck"],
    "after:bump": [
      "node scripts/release/set-version.mjs ${version}",
      "node scripts/release/changelog.mjs release ${version}",
      "npm install --package-lock-only --ignore-scripts",
      "git add CHANGELOG.md package-lock.json packages/core/package.json packages/react/package.json"
    ],
    "before:git:release": [
      "npm run build",
      "npm publish -w glyph-avatar",
      "npm publish -w @glyph-avatar/react"
    ]
  }
}
