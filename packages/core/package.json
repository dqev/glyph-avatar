{
  "name": "glyph-avatars",
  "version": "0.1.0",
  "description": "Seeded geometric SVG avatars, plus a React avatar picker. Same avatar for the same text everywhere.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "avatar",
    "svg",
    "identicon",
    "generative",
    "seeded",
    "deterministic",
    "react",
    "avatar-picker"
  ],
  "author": "Kamran Ahmed <kamranahmed.se@gmail.com> (https://kamranahmed.se)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilbuild/glyph-avatars.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nilbuild/glyph-avatars",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
