{
  "name": "glyph-avatar",
  "version": "0.1.0",
  "description": "Seeded geometric SVG avatars. Give it any text and get the same avatar every time.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "avatar",
    "svg",
    "identicon",
    "generative",
    "seeded",
    "deterministic"
  ],
  "author": "Kamran Ahmed <kamranahmed.se@gmail.com> (https://kamranahmed.se)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilbuild/glyph-avatar.git",
    "directory": "packages/core"
  },
  "homepage": "https://kamran.fyi/glyph-avatar",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
