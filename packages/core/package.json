{
  "name": "glyph-avatar",
  "version": "0.0.0",
  "description": "Seeded geometric SVG avatars, plus React components and an avatar picker. Give it any text and get the same avatar every time.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepack": "node ../../scripts/release/package-readme.mjs",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "test": "vitest run"
  },
  "keywords": [
    "avatar",
    "svg",
    "identicon",
    "generative",
    "seeded",
    "deterministic",
    "react",
    "avatar-picker"
  ],
  "author": "Kamran Ahmed <kamranahmed.se@gmail.com> (https://kamranahmed.se)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilbuild/glyph-avatar.git",
    "directory": "packages/core"
  },
  "homepage": "https://kamran.fyi/glyph-avatar",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "@types/react": "^19.1.8",
    "react": "^19.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
